{
  "name": "dsh-expert-council",
  "version": "0.3.1",
  "description": "User-gated expert panels for DSH: describe adjustments in plain language, editable experts and team composition, explicit-use consent, isolation from built-in Agent Teams, evidence-first protocol, token budgets and a queryable decision ledger.",
  "license": "MIT",
  "author": "YansongG-HKU",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YansongG-HKU/dsh-expert-council.git"
  },
  "homepage": "https://github.com/YansongG-HKU/dsh-expert-council#readme",
  "bugs": {
    "url": "https://github.com/YansongG-HKU/dsh-expert-council/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "expert-panel",
    "multi-expert-review",
    "decision-ledger",
    "protocol",
    "token-budget"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  }
}
